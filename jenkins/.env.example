# Copy to jenkins/.env (git-ignored) and fill in, then run jenkins/bootstrap.sh.
# bootstrap.sh turns these values into files in jenkins/secrets/; they are not passed
# to the container as environment variables, so pipeline steps cannot print them.

# Password of the Jenkins "admin" user.
JENKINS_ADMIN_PASSWORD=

# Docker Hub account the pipeline pushes <username>/cats-sim to, and a personal access
# token with Read & Write scope (hub.docker.com → Account settings → Personal access tokens).
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
